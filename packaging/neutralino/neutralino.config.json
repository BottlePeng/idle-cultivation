{
  "applicationId": "com.xiantu.idle",
  "applicationName": "仙途挂机",
  "applicationVersion": "1.0.0",
  "applicationVendor": "BottlePeng",
  "applicationDescription": "修仙挂机小游戏，纯静态网页版。",
  "cli": {
    "binaryName": "仙途挂机",
    "resourcesPath": "./www",
    "extensionsPath": "./extensions",
    "distributionPath": "./dist"
  },
  "modes": {
    "window": {
      "alwaysOnTop": false,
      "borderless": false,
      "enableInspector": false,
      "fullScreen": false,
      "height": 760,
      "width": 1180,
      "maxHeight": 1440,
      "maxWidth": 2400,
      "minHeight": 520,
      "minWidth": 800,
      "resizable": true,
      "title": "仙途挂机 · Idle Cultivation",
      "visible": true
    }
  },
  "documentRoot": "./www",
  "url": "./index.html",
  "enableServer": false,
  "extensions": [],
  "logging": {
    "enabled": false
  },
  "features": {
    "autoReload": { "enabled": false },
    "backgroundThrottling": { "enabled": false },
    "exitProcessOnLastWindowClose": { "enabled": true },
    "singleInstance": { "enabled": false }
  }
}
